{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shadcn/filterable-sections",
	"version": "1.0.0",
	"title": "Filterable Sections",
	"category": "shadcn",
	"icon": "filter",
	"description": "Labelled sections with a dropdown that narrows the page down to one of them.",
	"keywords": [ "filter", "sections", "categories", "listings", "careers", "jobs" ],
	"textdomain": "shadcn-blocks",
	"attributes": {
		"filterLabel": {
			"type": "string",
			"default": "Filter"
		},
		"allOptionLabel": {
			"type": "string",
			"default": "All"
		},
		"control": {
			"type": "string",
			"default": "dropdown",
			"enum": [ "dropdown", "buttons" ]
		},
		"controlPosition": {
			"type": "string",
			"default": "top",
			"enum": [ "top", "side" ]
		}
	},
	"example": {
		"attributes": {
			"filterLabel": "Filter",
			"allOptionLabel": "All departments",
			"control": "dropdown",
			"controlPosition": "top"
		},
		"innerBlocks": [
			{
				"name": "shadcn/filter-section",
				"attributes": {
					"label": "Engineering",
					"headingLevel": 3,
					"showLabel": true
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Senior Platform Engineer — Lisbon, Portugal · Hybrid"
						}
					},
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Site Reliability Engineer — Remote · Europe"
						}
					}
				]
			},
			{
				"name": "shadcn/filter-section",
				"attributes": {
					"label": "Design",
					"headingLevel": 3,
					"showLabel": true
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Senior Product Designer — Remote · Worldwide"
						}
					},
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Design Systems Lead — Berlin, Germany"
						}
					}
				]
			},
			{
				"name": "shadcn/filter-section",
				"attributes": {
					"label": "Customer Operations",
					"headingLevel": 3,
					"showLabel": true
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Customer Success Lead — Sydney, Australia"
						}
					}
				]
			}
		],
		"viewportWidth": 1100
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"allowedBlocks": [ "shadcn/filter-section" ],
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
