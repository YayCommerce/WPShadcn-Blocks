{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/accordion-item",
  "version": "1.0.0",
  "title": "Accordion Item",
  "category": "shadcn",
  "description": "A single collapsible section with a trigger and panel content.",
  "textdomain": "yaycommerce-blocks-for-shadcn-ui",
  "parent": ["shadcn/accordion"],
  "usesContext": ["shadcn/headingLevel"],
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "padding": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "summary": {
      "type": "string",
      "default": ""
    },
    "iconId": {
      "type": "number",
      "default": 0
    },
    "iconUrl": {
      "type": "string",
      "default": ""
    },
    "iconAlt": {
      "type": "string",
      "default": ""
    },
    "disabled": {
      "type": "boolean",
      "default": false
    }
  },
  "example": {
    "attributes": {
      "title": "Can I return an item?"
    },
    "innerBlocks": [
      {
        "name": "core/paragraph",
        "attributes": {
          "content": "You have thirty days from delivery. Send it back unworn in its original packaging and the refund lands on your card within a week."
        }
      }
    ],
    "viewportWidth": 600
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
