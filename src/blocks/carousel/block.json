{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shadcn/carousel",
	"version": "1.0.0",
	"title": "Carousel",
	"category": "shadcn",
	"icon": "slides",
	"description": "A flexible carousel that wraps any content including posts and products.",
	"keywords": [ "carousel", "slider", "gallery", "slideshow" ],
	"textdomain": "shadcn-blocks",
	"attributes": {
		"autoplay": {
			"type": "boolean",
			"default": false
		},
		"autoplayDelay": {
			"type": "number",
			"default": 3000
		},
		"loop": {
			"type": "boolean",
			"default": true
		},
		"showArrows": {
			"type": "boolean",
			"default": true
		},
		"showDots": {
			"type": "boolean",
			"default": true
		},
		"slidesPerView": {
			"type": "number",
			"default": 1
		},
		"slidesPerViewTablet": {
			"type": "number",
			"default": 2
		},
		"slidesPerViewDesktop": {
			"type": "number",
			"default": 3
		},
		"gap": {
			"type": "string",
			"default": "1rem"
		},
		"orientation": {
			"type": "string",
			"default": "horizontal"
		},
		"effect": {
			"type": "string",
			"default": "none",
			"enum": [ "none", "coverflow" ]
		}
	},
	"example": {
		"attributes": {
			"autoplay": false,
			"loop": true,
			"showArrows": true,
			"showDots": true,
			"slidesPerView": 1,
			"slidesPerViewTablet": 2,
			"slidesPerViewDesktop": 3,
			"gap": "1.5rem",
			"orientation": "horizontal",
			"effect": "coverflow"
		},
		"innerBlocks": [
			{
				"name": "shadcn/carousel-item",
				"attributes": {},
				"innerBlocks": [
					{
						"name": "core/heading",
						"attributes": {
							"level": 3,
							"content": "Plan your work"
						}
					},
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Map out the release, then hand each step to the right person."
						}
					}
				]
			},
			{
				"name": "shadcn/carousel-item",
				"attributes": {},
				"innerBlocks": [
					{
						"name": "core/heading",
						"attributes": {
							"level": 3,
							"content": "Build it together"
						}
					},
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Review changes side by side and keep everyone on the same version."
						}
					}
				]
			},
			{
				"name": "shadcn/carousel-item",
				"attributes": {},
				"innerBlocks": [
					{
						"name": "core/heading",
						"attributes": {
							"level": 3,
							"content": "Ship with confidence"
						}
					},
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Publish when the checks pass and roll back in a single click."
						}
					}
				]
			}
		],
		"viewportWidth": 1200
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
