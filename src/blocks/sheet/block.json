{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/sheet",
  "version": "1.0.0",
  "title": "Sheet",
  "category": "shadcn",
  "description": "Sheet block to display additional content, actions, or navigation in a modal dialog.",
  "keywords": ["sheet", "modal", "panel"],
  "textdomain": "yaycommerce-blocks-for-shadcn-ui",
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": false
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "width": true
    }
  },
  "attributes": {
    "dismissible": {
      "type": "boolean",
      "default": true
    },
    "direction": {
      "type": "string",
      "default": "right"
    }
  },
  "example": {
    "attributes": {
      "dismissible": true,
      "direction": "right"
    },
    "innerBlocks": [
      {
        "name": "shadcn/sheet-trigger",
        "attributes": {},
        "innerBlocks": [
          {
            "name": "core/buttons",
            "attributes": {},
            "innerBlocks": [
              {
                "name": "core/button",
                "attributes": {
                  "text": "Edit profile",
                  "className": "is-style-outline"
                }
              }
            ]
          }
        ]
      },
      {
        "name": "shadcn/sheet-header",
        "attributes": {},
        "innerBlocks": [
          {
            "name": "core/heading",
            "attributes": {
              "level": 3,
              "content": "Edit profile"
            }
          },
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Make changes to your profile here. Click save when you're done."
            }
          }
        ]
      },
      {
        "name": "shadcn/sheet-content",
        "attributes": {},
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Your display name and contact details appear on every comment and order confirmation you send."
            }
          }
        ]
      },
      {
        "name": "shadcn/sheet-footer",
        "attributes": {},
        "innerBlocks": [
          {
            "name": "core/buttons",
            "attributes": {},
            "innerBlocks": [
              {
                "name": "core/button",
                "attributes": {
                  "text": "Save changes"
                }
              },
              {
                "name": "core/button",
                "attributes": {
                  "text": "Close",
                  "className": "is-style-outline"
                }
              }
            ]
          }
        ]
      }
    ],
    "viewportWidth": 900
  },
  "allowedBlocks": [
    "shadcn/sheet-trigger",
    "shadcn/sheet-header",
    "shadcn/sheet-content",
    "shadcn/sheet-footer"
  ],
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}
