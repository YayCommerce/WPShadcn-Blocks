{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shadcn/card-header",
	"version": "1.0.0",
	"title": "Card Header",
	"category": "shadcn",
	"parent": [ "shadcn/card" ],
	"icon": "heading",
	"description": "Card header section for title and description.",
	"textdomain": "shadcn-blocks",
	"attributes": {},
	"example": {
		"attributes": {},
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"level": 3,
					"content": "Starter plan"
				}
			},
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Everything one person needs to launch a first site."
				}
			}
		],
		"viewportWidth": 600
	},
	"supports": {
		"html": false,
		"reusable": false,
		"lock": false
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
