{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/marker",
  "version": "1.0.0",
  "title": "Marker",
  "category": "shadcn",
  "description": "A small labeled meta-row: a muted text line, a centered separator, or a bordered label.",
  "textdomain": "yaycommerce-blocks-for-shadcn-ui",
  "keywords": ["marker", "label", "meta", "separator", "divider"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "content": {
      "type": "string",
      "default": ""
    },
    "variant": {
      "type": "string",
      "default": "default"
    },
    "shimmer": {
      "type": "boolean",
      "default": false
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "linkTarget": {
      "type": "string",
      "default": ""
    },
    "rel": {
      "type": "string",
      "default": ""
    }
  },
  "example": {
    "attributes": {
      "content": "What's included",
      "variant": "separator",
      "shimmer": false
    },
    "viewportWidth": 500
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
