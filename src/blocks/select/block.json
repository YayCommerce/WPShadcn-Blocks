{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/select",
  "version": "1.0.0",
  "title": "Select",
  "category": "shadcn",
  "description": "A labeled dropdown of predefined options for forms.",
  "textdomain": "shadcn-blocks",
  "keywords": ["select", "dropdown", "options", "field", "form"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": false,
    "spacing": {
      "margin": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": ""
    },
    "fieldName": {
      "type": "string",
      "default": ""
    },
    "placeholder": {
      "type": "string",
      "default": ""
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "options": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
