{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/sheet-header",
  "version": "1.0.0",
  "title": "Sheet Header",
  "category": "shadcn",
  "parent": ["shadcn/sheet"],
  "icon": "heading",
  "description": "Sheet header section for title and description.",
  "textdomain": "shadcn-blocks",
  "attributes": {},
  "example": {
    "innerBlocks": [
      {
        "name": "core/heading",
        "attributes": {
          "level": 3,
          "content": "Edit profile"
        }
      },
      {
        "name": "core/paragraph",
        "attributes": {
          "content": "Make changes to your profile here. Click save when you're done."
        }
      }
    ],
    "viewportWidth": 600
  },
  "supports": {
    "html": false,
    "reusable": false,
    "lock": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
