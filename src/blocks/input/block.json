{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/input",
  "version": "1.0.0",
  "title": "Input",
  "category": "shadcn",
  "description": "A labeled text, email, or phone field for forms.",
  "textdomain": "shadcn-blocks",
  "keywords": ["input", "field", "text", "email", "phone", "form"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": false,
    "spacing": {
      "margin": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": ""
    },
    "fieldName": {
      "type": "string",
      "default": ""
    },
    "type": {
      "type": "string",
      "default": "text"
    },
    "placeholder": {
      "type": "string",
      "default": ""
    },
    "required": {
      "type": "boolean",
      "default": false
    }
  },
  "example": {
    "attributes": {
      "label": "Email",
      "fieldName": "email",
      "type": "email",
      "placeholder": "you@example.com",
      "required": true
    },
    "viewportWidth": 500
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
