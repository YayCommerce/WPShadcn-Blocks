{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/bubble-group",
  "version": "1.0.0",
  "title": "Bubble Group",
  "category": "shadcn",
  "description": "A vertical stack of message bubbles for chat and conversation mockups.",
  "textdomain": "yaycommerce-blocks-for-shadcn-ui",
  "keywords": ["bubble", "chat", "conversation", "messages"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "start"
    }
  },
  "example": {
    "attributes": {
      "align": "start"
    },
    "innerBlocks": [
      {
        "name": "shadcn/bubble",
        "attributes": {
          "variant": "muted",
          "align": "start"
        },
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Hey! Is the new landing page ready to review?"
            }
          }
        ]
      },
      {
        "name": "shadcn/bubble",
        "attributes": {
          "variant": "default",
          "align": "end"
        },
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Just pushed it — take a look whenever."
            }
          }
        ]
      },
      {
        "name": "shadcn/bubble",
        "attributes": {
          "variant": "muted",
          "align": "start"
        },
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Looks great. Shipping it today."
            }
          }
        ]
      }
    ],
    "viewportWidth": 700
  },
  "providesContext": {
    "shadcn/bubble-align": "align"
  },
  "allowedBlocks": ["shadcn/bubble"],
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
