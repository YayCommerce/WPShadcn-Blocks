{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/tab",
  "version": "1.0.0",
  "title": "Tab",
  "category": "shadcn",
  "description": "A single tab with its label and panel content.",
  "textdomain": "shadcn-blocks",
  "parent": ["shadcn/tabs"],
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "padding": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": ""
    },
    "disabled": {
      "type": "boolean",
      "default": false
    }
  },
  "example": {
    "attributes": {
      "label": "Account",
      "disabled": false
    },
    "innerBlocks": [
      {
        "name": "core/heading",
        "attributes": { "level": 4, "content": "Account" }
      },
      {
        "name": "core/paragraph",
        "attributes": {
          "content": "Update your name and email address, then save when you are done."
        }
      }
    ],
    "viewportWidth": 500
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
