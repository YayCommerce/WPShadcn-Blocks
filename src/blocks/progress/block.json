{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpshadcn/progress",
  "version": "1.0.0",
  "title": "Progress",
  "category": "wpshadcn",
  "description": "A progress bar for loading indicators and progress bars.",
  "keywords": ["progress", "bar", "indicator"],
  "textdomain": "wpshadcn-blocks",
  "attributes": {
    "maxValue": {
      "type": "number",
      "default": 100
    },
    "currentValue": {
      "type": "string",
      "default": "static"
    },
    "staticValue": {
      "type": "number",
      "default": 50
    },
    "dynamicValue": {
      "type": "string",
      "default": "free_shipping"
    },
    "showLabel": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "width": true,
      "style": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
