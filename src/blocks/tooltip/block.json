{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/tooltip",
  "version": "1.0.0",
  "title": "Tooltip",
  "category": "shadcn",
  "icon": "editor-help",
  "description": "A tooltip for displaying additional information.",
  "keywords": ["tooltip", "information", "help", "popup"],
  "textdomain": "shadcn-blocks",
  "attributes": {
    "action": {
      "type": "string",
      "default": "hover",
      "enum": ["hover", "click"]
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": false
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "width": true
    }
  },
  "example": {
    "attributes": {
      "action": "hover"
    },
    "innerBlocks": [
      {
        "name": "shadcn/tooltip-trigger",
        "attributes": {},
        "innerBlocks": [
          {
            "name": "core/button",
            "attributes": {
              "text": "Hover me",
              "className": "is-style-outline"
            }
          }
        ]
      },
      {
        "name": "shadcn/tooltip-content",
        "attributes": {},
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": { "content": "Extra detail, only when it is needed." }
          }
        ]
      }
    ],
    "viewportWidth": 400
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}
