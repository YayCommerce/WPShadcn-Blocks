{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/avatar-group",
  "version": "1.0.0",
  "title": "Avatar Group",
  "category": "shadcn",
  "description": "A stack of overlapping avatars with an automatic \"+N\" overflow indicator.",
  "keywords": ["avatar", "group", "stack", "users"],
  "textdomain": "shadcn-blocks",
  "attributes": {
    "maxVisible": {
      "type": "number",
      "default": 5
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": false,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
