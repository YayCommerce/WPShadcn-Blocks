{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/avatar-group",
  "version": "1.0.0",
  "title": "Avatar Group",
  "category": "shadcn",
  "description": "A stack of overlapping avatars with an automatic \"+N\" overflow indicator.",
  "keywords": ["avatar", "group", "stack", "users"],
  "textdomain": "shadcn-blocks",
  "attributes": {
    "maxVisible": {
      "type": "number",
      "default": 5
    }
  },
  "example": {
    "attributes": {
      "maxVisible": 5
    },
    "innerBlocks": [
      {
        "name": "shadcn/avatar",
        "attributes": {
          "size": "lg",
          "fallback": "CN"
        }
      },
      {
        "name": "shadcn/avatar",
        "attributes": {
          "size": "lg",
          "fallback": "AB"
        }
      },
      {
        "name": "shadcn/avatar",
        "attributes": {
          "size": "lg",
          "fallback": "JD"
        }
      },
      {
        "name": "shadcn/avatar",
        "attributes": {
          "size": "lg",
          "fallback": "MK"
        }
      },
      {
        "name": "shadcn/avatar",
        "attributes": {
          "size": "lg",
          "fallback": "RF"
        }
      }
    ],
    "viewportWidth": 600
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": false,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
