{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpshadcn/alert",
  "version": "1.0.0",
  "title": "Alert",
  "category": "wpshadcn",
  "description": "Alert block to displays a callout for user attention.",
  "textdomain": "wpshadcn-blocks",
  "keywords": ["alert", "callout", "message", "notification"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "variant": {
      "type": "string",
      "default": "default"
    },
    "dismissible": {
      "type": "boolean",
      "default": false
    }
  },
  "providesContext": {
    "wpshadcn/alert-variant": "variant",
    "wpshadcn/alert-dismissible": "dismissible"
  },
  "allowedBlocks": ["wpshadcn/alert-title", "wpshadcn/alert-description"],
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
