{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/drawer",
  "version": "1.0.0",
  "title": "Drawer",
  "category": "shadcn",
  "description": "Drawer block to display additional content, actions, or navigation without leaving the current page.",
  "keywords": ["overlay", "modal", "panel"],
  "textdomain": "shadcn-blocks",
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": false
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "width": true
    }
  },
  "attributes": {
    "dismissible": {
      "type": "boolean",
      "default": false
    },
    "direction": {
      "type": "string",
      "default": "bottom"
    }
  },
  "allowedBlocks": [
    "shadcn/drawer-trigger",
    "shadcn/drawer-header",
    "shadcn/drawer-content",
    "shadcn/drawer-footer"
  ],
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}
