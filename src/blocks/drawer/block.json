{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/drawer",
  "version": "1.0.0",
  "title": "Drawer",
  "category": "shadcn",
  "description": "Drawer block to display additional content, actions, or navigation without leaving the current page.",
  "keywords": ["overlay", "modal", "panel"],
  "textdomain": "shadcn-blocks",
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": false
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "width": true
    }
  },
  "attributes": {
    "dismissible": {
      "type": "boolean",
      "default": false
    },
    "direction": {
      "type": "string",
      "default": "bottom"
    }
  },
  "example": {
    "attributes": {
      "dismissible": true,
      "direction": "bottom"
    },
    "innerBlocks": [
      {
        "name": "shadcn/drawer-trigger",
        "attributes": {},
        "innerBlocks": [
          {
            "name": "core/buttons",
            "attributes": {},
            "innerBlocks": [
              {
                "name": "core/button",
                "attributes": {
                  "text": "Cookie settings",
                  "className": "is-style-outline"
                }
              }
            ]
          }
        ]
      },
      {
        "name": "shadcn/drawer-header",
        "attributes": {},
        "innerBlocks": [
          {
            "name": "core/heading",
            "attributes": {
              "level": 3,
              "content": "Cookie preferences"
            }
          },
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Choose which categories of cookies this site may use."
            }
          }
        ]
      },
      {
        "name": "shadcn/drawer-content",
        "attributes": {},
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Strictly necessary cookies keep the site working and cannot be switched off. Analytics and personalisation cookies stay off until you allow them."
            }
          }
        ]
      },
      {
        "name": "shadcn/drawer-footer",
        "attributes": {},
        "innerBlocks": [
          {
            "name": "core/buttons",
            "attributes": {
              "layout": {
                "type": "flex",
                "justifyContent": "right"
              }
            },
            "innerBlocks": [
              {
                "name": "core/button",
                "attributes": {
                  "text": "Reject all",
                  "className": "is-style-outline"
                }
              },
              {
                "name": "core/button",
                "attributes": {
                  "text": "Save preferences"
                }
              }
            ]
          }
        ]
      }
    ],
    "viewportWidth": 900
  },
  "allowedBlocks": [
    "shadcn/drawer-trigger",
    "shadcn/drawer-header",
    "shadcn/drawer-content",
    "shadcn/drawer-footer"
  ],
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}
