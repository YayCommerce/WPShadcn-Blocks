{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/accordion",
  "version": "1.0.0",
  "title": "Accordion",
  "category": "shadcn",
  "description": "A vertically stacked set of collapsible sections. One section opens at a time.",
  "keywords": ["accordion", "collapse", "faq", "toggle", "disclosure"],
  "textdomain": "yaycommerce-blocks-for-shadcn-ui",
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": false
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "width": true
    }
  },
  "attributes": {
    "headingLevel": {
      "type": "number",
      "default": 3
    },
    "allowMultiple": {
      "type": "boolean",
      "default": false
    },
    "outlined": {
      "type": "boolean",
      "default": false
    },
    "openFirst": {
      "type": "boolean",
      "default": false
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "autoplayDelay": {
      "type": "number",
      "default": 5000
    }
  },
  "example": {
    "attributes": {
      "headingLevel": 3,
      "openFirst": true
    },
    "innerBlocks": [
      {
        "name": "shadcn/accordion-item",
        "attributes": {
          "title": "How long does delivery take?"
        },
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Orders leave the warehouse within one working day and arrive in two to four days, with tracking sent as soon as the parcel is scanned."
            }
          }
        ]
      },
      {
        "name": "shadcn/accordion-item",
        "attributes": {
          "title": "Can I return an item?"
        },
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "You have thirty days from delivery. Send it back unworn in its original packaging and the refund lands on your card within a week."
            }
          }
        ]
      },
      {
        "name": "shadcn/accordion-item",
        "attributes": {
          "title": "Do you ship internationally?"
        },
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "We ship to most of Europe and North America. Duties are shown at checkout, so the price you pay is the final one."
            }
          }
        ]
      }
    ],
    "viewportWidth": 800
  },
  "providesContext": {
    "shadcn/headingLevel": "headingLevel"
  },
  "allowedBlocks": ["shadcn/accordion-item"],
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}
