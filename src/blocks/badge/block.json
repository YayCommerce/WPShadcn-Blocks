{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/badge",
  "version": "1.0.0",
  "title": "Badge",
  "category": "shadcn",
  "description": "A small inline label or status pill with variants and an optional link.",
  "textdomain": "yaycommerce-blocks-for-shadcn-ui",
  "keywords": ["badge", "label", "tag", "pill", "status"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": false,
    "spacing": {
      "margin": true
    }
  },
  "attributes": {
    "text": {
      "type": "string",
      "default": ""
    },
    "variant": {
      "type": "string",
      "default": "default"
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "linkTarget": {
      "type": "string",
      "default": ""
    },
    "rel": {
      "type": "string",
      "default": ""
    },
    "iconName": {
      "type": "string",
      "default": ""
    },
    "iconPosition": {
      "type": "string",
      "default": "left"
    },
    "iconSize": {
      "type": "string",
      "default": ""
    }
  },
  "example": {
    "attributes": {
      "text": "Version 2.0 is live",
      "variant": "secondary",
      "iconName": "sparkles",
      "iconPosition": "left"
    },
    "viewportWidth": 400
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
