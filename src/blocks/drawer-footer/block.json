{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/drawer-footer",
  "version": "1.0.0",
  "title": "Drawer Footer",
  "category": "shadcn",
  "parent": ["shadcn/drawer"],
  "icon": "heading",
  "description": "Drawer footer section for footer content.",
  "textdomain": "yaycommerce-blocks-for-shadcn-ui",
  "attributes": {},
  "example": {
    "innerBlocks": [
      {
        "name": "core/buttons",
        "attributes": {
          "layout": {
            "type": "flex",
            "justifyContent": "right"
          }
        },
        "innerBlocks": [
          {
            "name": "core/button",
            "attributes": {
              "text": "Reject all",
              "className": "is-style-outline"
            }
          },
          {
            "name": "core/button",
            "attributes": {
              "text": "Save preferences"
            }
          }
        ]
      }
    ],
    "viewportWidth": 600
  },
  "supports": {
    "html": false,
    "reusable": false,
    "lock": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
