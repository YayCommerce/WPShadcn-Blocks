{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/empty",
  "version": "1.0.0",
  "title": "Empty",
  "category": "shadcn",
  "icon": "marker",
  "description": "An empty state placeholder with centered content.",
  "keywords": ["empty", "placeholder", "no results", "blank"],
  "textdomain": "yaycommerce-blocks-for-shadcn-ui",
  "attributes": {},
  "example": {
    "attributes": {},
    "innerBlocks": [
      {
        "name": "core/group",
        "attributes": {
          "layout": {
            "type": "flex",
            "flexWrap": "nowrap",
            "justifyContent": "center"
          }
        },
        "innerBlocks": [
          {
            "name": "core/group",
            "attributes": {},
            "innerBlocks": [
              {
                "name": "core/heading",
                "attributes": {
                  "level": 3,
                  "style": { "typography": { "textAlign": "center" } },
                  "content": "No projects yet"
                }
              },
              {
                "name": "core/paragraph",
                "attributes": {
                  "align": "center",
                  "content": "Create your first project to start tracking work, inviting teammates and sharing progress.",
                  "textColor": "muted-foreground"
                }
              },
              {
                "name": "core/buttons",
                "attributes": {
                  "layout": {
                    "type": "flex",
                    "justifyContent": "center"
                  }
                },
                "innerBlocks": [
                  {
                    "name": "core/button",
                    "attributes": {
                      "text": "Create project"
                    }
                  },
                  {
                    "name": "core/button",
                    "attributes": {
                      "text": "Import project",
                      "className": "is-style-outline"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "viewportWidth": 700
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "width": true,
      "style": true
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
