{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shadcn/card",
	"version": "1.0.0",
	"title": "Card",
	"category": "shadcn",
	"icon": "id-alt",
	"description": "A card container with header, content, and footer sections.",
	"keywords": [ "card", "container", "box", "panel" ],
	"textdomain": "shadcn-blocks",
	"attributes": {},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": false
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"width": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
