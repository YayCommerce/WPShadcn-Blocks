{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shadcn/card",
	"version": "1.0.0",
	"title": "Card",
	"category": "shadcn",
	"icon": "id-alt",
	"description": "A card container with header, content, and footer sections.",
	"keywords": [ "card", "container", "box", "panel" ],
	"textdomain": "yaycommerce-blocks-for-shadcn-ui",
	"attributes": {},
	"example": {
		"attributes": {},
		"innerBlocks": [
			{
				"name": "shadcn/card-header",
				"attributes": {},
				"innerBlocks": [
					{
						"name": "core/heading",
						"attributes": {
							"level": 3,
							"content": "Starter plan"
						}
					},
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Everything one person needs to launch a first site."
						}
					}
				]
			},
			{
				"name": "shadcn/card-content",
				"attributes": {},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "$19 per month, billed yearly. Three active projects, unlimited pages and monthly component drops."
						}
					}
				]
			},
			{
				"name": "shadcn/card-footer",
				"attributes": {},
				"innerBlocks": [
					{
						"name": "core/buttons",
						"attributes": {},
						"innerBlocks": [
							{
								"name": "core/button",
								"attributes": {
									"text": "Choose Starter"
								}
							}
						]
					}
				]
			}
		],
		"viewportWidth": 700
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": false
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"width": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
