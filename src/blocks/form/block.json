{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/form",
  "version": "1.0.0",
  "title": "Form",
  "category": "shadcn",
  "description": "A form that emails its fields to the site admin or a chosen recipient on submit.",
  "textdomain": "shadcn-blocks",
  "keywords": ["form", "contact", "newsletter", "submit", "email"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "formName": {
      "type": "string",
      "default": "Contact"
    },
    "recipient": {
      "type": "string",
      "default": ""
    },
    "successMessage": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}
