{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/form",
  "version": "1.0.0",
  "title": "Form",
  "category": "shadcn",
  "description": "A form that emails its fields to the site admin or a chosen recipient on submit.",
  "textdomain": "yaycommerce-blocks-for-shadcn-ui",
  "keywords": ["form", "contact", "newsletter", "submit", "email"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "formName": {
      "type": "string",
      "default": "Contact"
    },
    "recipient": {
      "type": "string",
      "default": ""
    },
    "successMessage": {
      "type": "string",
      "default": ""
    }
  },
  "example": {
    "attributes": {
      "formName": "Contact",
      "recipient": "",
      "successMessage": "Thanks — we’ll get back to you soon."
    },
    "innerBlocks": [
      {
        "name": "shadcn/input",
        "attributes": {
          "label": "Full name",
          "fieldName": "full-name",
          "type": "text",
          "placeholder": "Ada Okafor",
          "required": true
        }
      },
      {
        "name": "shadcn/input",
        "attributes": {
          "label": "Email",
          "fieldName": "email",
          "type": "email",
          "placeholder": "you@example.com",
          "required": true
        }
      },
      {
        "name": "shadcn/textarea",
        "attributes": {
          "label": "Message",
          "fieldName": "message",
          "placeholder": "Tell us what you need",
          "required": true,
          "rows": 4
        }
      },
      {
        "name": "shadcn/form-submit",
        "attributes": {
          "label": "Send message",
          "width": 100
        }
      }
    ],
    "viewportWidth": 800
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}
