{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/countdown",
  "version": "1.0.0",
  "title": "Countdown",
  "category": "shadcn",
  "description": "A timer counting down to a date and time, for promo banners and launch pages.",
  "keywords": ["countdown", "timer", "deadline", "sale", "launch"],
  "textdomain": "shadcn-blocks",
  "attributes": {
    "targetDate": {
      "type": "string",
      "default": ""
    },
    "showDays": {
      "type": "boolean",
      "default": true
    },
    "showSeconds": {
      "type": "boolean",
      "default": true
    },
    "showLabels": {
      "type": "boolean",
      "default": false
    },
    "separator": {
      "type": "string",
      "default": ":"
    },
    "pulseSeparator": {
      "type": "boolean",
      "default": false
    },
    "onExpire": {
      "type": "string",
      "default": "hide"
    },
    "expiredMessage": {
      "type": "string",
      "default": ""
    }
  },
  "example": {
    "attributes": {
      "showDays": true,
      "showSeconds": true,
      "showLabels": true,
      "separator": ":",
      "pulseSeparator": false,
      "onExpire": "hide"
    },
    "viewportWidth": 700
  },
  "supports": {
    "html": false,
    "anchor": true,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontWeight": true,
      "__experimentalFontFamily": true,
      "__experimentalLetterSpacing": true
    }
  },
  "styles": [
    {
      "name": "default",
      "label": "Plain",
      "isDefault": true
    },
    {
      "name": "boxed",
      "label": "Boxed"
    }
  ],
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
