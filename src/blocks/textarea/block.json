{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/textarea",
  "version": "1.0.0",
  "title": "Textarea",
  "category": "shadcn",
  "description": "A labeled multi-line text field for form messages.",
  "textdomain": "shadcn-blocks",
  "keywords": ["textarea", "message", "field", "form"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": false,
    "spacing": {
      "margin": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": ""
    },
    "fieldName": {
      "type": "string",
      "default": ""
    },
    "placeholder": {
      "type": "string",
      "default": ""
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "rows": {
      "type": "number",
      "default": 4
    }
  },
  "example": {
    "attributes": {
      "label": "Message",
      "fieldName": "message",
      "placeholder": "Tell us what you need",
      "required": true,
      "rows": 4
    },
    "viewportWidth": 500
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
