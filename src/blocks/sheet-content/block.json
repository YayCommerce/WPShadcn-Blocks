{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/sheet-content",
  "version": "1.0.0",
  "title": "Sheet Content",
  "category": "shadcn",
  "parent": ["shadcn/sheet"],
  "icon": "text",
  "description": "Sheet content section for main body content.",
  "textdomain": "shadcn-blocks",
  "attributes": {},
  "example": {
    "innerBlocks": [
      {
        "name": "core/paragraph",
        "attributes": {
          "content": "Your display name and contact details appear on every comment you post."
        }
      },
      {
        "name": "core/paragraph",
        "attributes": {
          "content": "Updates take effect as soon as you save."
        }
      }
    ],
    "viewportWidth": 600
  },
  "supports": {
    "html": false,
    "reusable": false,
    "lock": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
