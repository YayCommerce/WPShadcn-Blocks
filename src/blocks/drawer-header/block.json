{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/drawer-header",
  "version": "1.0.0",
  "title": "Drawer Header",
  "category": "shadcn",
  "parent": ["shadcn/drawer"],
  "icon": "heading",
  "description": "Drawer header section for title and description.",
  "textdomain": "yaycommerce-blocks-for-shadcn-ui",
  "attributes": {},
  "example": {
    "innerBlocks": [
      {
        "name": "core/heading",
        "attributes": {
          "level": 3,
          "content": "Cookie preferences"
        }
      },
      {
        "name": "core/paragraph",
        "attributes": {
          "content": "Choose which categories of cookies this site may use."
        }
      }
    ],
    "viewportWidth": 600
  },
  "supports": {
    "html": false,
    "reusable": false,
    "lock": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
