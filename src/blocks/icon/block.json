{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpshadcn/icon",
  "version": "1.0.0",
  "title": "Icon",
  "category": "wpshadcn",
  "icon": "format-image",
  "description": "Insert an icon to make a visual statement.",
  "keywords": ["icon", "visual", "statement"],
  "textdomain": "wpshadcn-blocks",
  "attributes": {
    "icon": {
      "type": "string",
      "default": ""
    },
    "size": {
      "type": "string",
      "default": "24"
    },
    "color": {
      "type": "string",
      "default": "currentColor"
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "width": true,
      "style": true
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
