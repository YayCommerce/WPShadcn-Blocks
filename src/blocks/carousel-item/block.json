{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shadcn/carousel-item",
	"version": "1.0.0",
	"title": "Carousel Item",
	"category": "shadcn",
	"parent": [ "shadcn/carousel" ],
	"icon": "format-image",
	"description": "A single slide within a carousel.",
	"textdomain": "yaycommerce-blocks-for-shadcn-ui",
	"attributes": {},
	"example": {
		"attributes": {},
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"level": 3,
					"content": "Plan your work"
				}
			},
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Map out the release, then hand each step to the right person."
				}
			}
		],
		"viewportWidth": 700
	},
	"supports": {
		"html": false,
		"reusable": false,
		"lock": false,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"width": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
