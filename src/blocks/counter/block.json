{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/counter",
  "version": "1.0.0",
  "title": "Counter",
  "category": "shadcn",
  "description": "A number that counts up to its target value when it scrolls into view.",
  "keywords": ["counter", "number", "count up", "stat"],
  "textdomain": "shadcn-blocks",
  "attributes": {
    "startValue": {
      "type": "number",
      "default": 0
    },
    "endValue": {
      "type": "number",
      "default": 100
    },
    "duration": {
      "type": "number",
      "default": 2000
    },
    "decimals": {
      "type": "number",
      "default": 0
    },
    "separator": {
      "type": "boolean",
      "default": false
    },
    "suffix": {
      "type": "string",
      "default": ""
    }
  },
  "example": {
    "attributes": {
      "startValue": 0,
      "endValue": 1250,
      "duration": 2000,
      "decimals": 0,
      "separator": true,
      "suffix": "+"
    },
    "viewportWidth": 600
  },
  "supports": {
    "html": false,
    "anchor": true,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontWeight": true,
      "__experimentalFontFamily": true,
      "__experimentalLetterSpacing": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
