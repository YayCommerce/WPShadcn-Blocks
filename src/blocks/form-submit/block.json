{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/form-submit",
  "version": "1.0.0",
  "title": "Form Submit Button",
  "category": "shadcn",
  "description": "A real submit button for the Form block, with a pending spinner while sending.",
  "textdomain": "yaycommerce-blocks-for-shadcn-ui",
  "keywords": ["submit", "button", "form", "send"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": false,
    "spacing": {
      "margin": true
    },
    "color": {
      "background": true,
      "text": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": ""
    },
    "width": {
      "type": "number"
    },
    "alignment": {
      "type": "string",
      "default": ""
    }
  },
  "example": {
    "attributes": {
      "label": "Send message",
      "width": 100,
      "alignment": ""
    },
    "viewportWidth": 400
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
