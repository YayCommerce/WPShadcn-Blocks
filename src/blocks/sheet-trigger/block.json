{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shadcn/sheet-trigger",
  "version": "1.0.0",
  "title": "Sheet Trigger",
  "category": "shadcn",
  "parent": ["shadcn/sheet"],
  "icon": "button",
  "description": "Button or control that toggles the sheet.",
  "textdomain": "yaycommerce-blocks-for-shadcn-ui",
  "attributes": {},
  "example": {
    "innerBlocks": [
      {
        "name": "core/buttons",
        "attributes": {},
        "innerBlocks": [
          {
            "name": "core/button",
            "attributes": {
              "text": "Edit profile",
              "className": "is-style-outline"
            }
          }
        ]
      }
    ],
    "viewportWidth": 400
  },
  "supports": {
    "html": false,
    "reusable": false,
    "lock": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
