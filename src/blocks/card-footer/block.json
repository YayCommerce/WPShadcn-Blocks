{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shadcn/card-footer",
	"version": "1.0.0",
	"title": "Card Footer",
	"category": "shadcn",
	"parent": [ "shadcn/card" ],
	"icon": "minus",
	"description": "Card footer section for actions and buttons.",
	"textdomain": "shadcn-blocks",
	"attributes": {},
	"example": {
		"attributes": {},
		"innerBlocks": [
			{
				"name": "core/buttons",
				"attributes": {},
				"innerBlocks": [
					{
						"name": "core/button",
						"attributes": {
							"text": "Choose Starter"
						}
					}
				]
			}
		],
		"viewportWidth": 600
	},
	"supports": {
		"html": false,
		"reusable": false,
		"lock": false
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
